# Copy this file to .env and fill in your Supabase project's values
# (Settings → API in the Supabase dashboard). The publishable/anon key is
# safe to expose client-side — it's gated by the RLS policies in
# supabase/migrations/0001_init.sql, not a secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
