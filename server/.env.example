# Copy to .env and fill in before starting the server (docker-compose reads this file too).

# ── MariaDB ──────────────────────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_USER=pksof
DB_PASSWORD=change-me
DB_NAME=pksof

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long, random, secret — e.g. `openssl rand -hex 32`. Changing this logs out every session.
JWT_SECRET=change-me-to-a-long-random-string
# How long a signed-in session stays valid before needing to sign in again.
JWT_EXPIRES_IN=24h

# ── Password reset emails ───────────────────────────────────────────────────
# Any standard SMTP account works (your company's mail server, Microsoft 365, Google Workspace,
# a transactional-email provider). The internal server needs OUTBOUND access to this host even
# though it otherwise accepts no inbound traffic from outside your network.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=pksof@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="Group Performance Dashboard <pksof@example.com>"

# Base URL staff reach this app at on your internal network — used to build the link inside a
# password-reset email (e.g. http://pksof.internal:4000 or http://10.0.1.20:4000).
PUBLIC_APP_URL=http://pksof.internal:4000

# ── File uploads ─────────────────────────────────────────────────────────────
# Where uploaded .xlsx files are stored — mounted as a Docker volume in docker-compose.yml so it
# survives a container rebuild.
UPLOAD_DIR=/data/uploads

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of origins allowed to call this API — only needed if the frontend is NOT
# served by this same server (see docker-compose.yml's default, single-container setup).
CORS_ORIGINS=

# ── Optional: ongoing backup sync to Supabase (scripts/sync-to-supabase.ts) ──
# Leave blank to disable the nightly sync job entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
